; Engine configuration file, Godot's equivalent of a top-level CMakeCache.txt
; or a `[project]` section in a config file: engine-wide settings live here,
; game logic does not. Normally edited through the editor UI rather than by
; hand.

config_version=5

[application]

config/name="trampoline"
config/description="Un jeu pour faire rebondir les mots"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/app_icon.png"

[display]

; A portrait base resolution (roughly a phone's own aspect ratio), since
; the game is designed portrait-first (see main.tscn's vertical layout
; stack). `stretch/mode="canvas_items"` scales this logical resolution up
; to match a real screen's actual pixel density (so tiles/buttons stay a
; sensible physical size on a high-DPI phone) while `stretch/aspect=
; "expand"` — rather than "keep", which would letterbox with black bars —
; hands the extra width/height on a differently-shaped screen (a wide PC
; window, say) to the layout itself, so main.tscn's containers actually
; reflow into that space instead of just being scaled uniformly.
window/size/viewport_width=480
window/size/viewport_height=854
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
