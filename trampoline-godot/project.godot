; Engine configuration file, Godot's equivalent of a top-level CMakeCache.txt
; or a `[project]` section in a config file: engine-wide settings live here,
; game logic does not. Normally edited through the editor UI rather than by
; hand.

config_version=5

[application]

config/name="trampoline"
config/description="Un jeu pour faire rebondir les mots"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_height=700

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
